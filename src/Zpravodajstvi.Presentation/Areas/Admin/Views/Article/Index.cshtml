@model IEnumerable<ArticleListDto>
@{
    ViewData["Title"] = "Správa článků";
}

<div class="container mt-4">
    <partial name="_AdminNav" />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">Správa článků</h2>
        <a asp-area="Admin" asp-controller="Article" asp-action="Create" class="btn btn-primary">
            + Přidat nový článek
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Titulek</th>
                    <th>Kategorie</th>
                    <th>Autor</th>
                    <th>Datum vytvoření</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var article in Model)
                    {
                        <tr>
                            <td>@article.Id</td>
                            <td>@article.Title</td>
                            <td>@article.CategoryName</td>
                            <td>@article.AuthorName</td>
                            <td>@article.CreatedAt.ToShortDateString()</td>
                            <td class="text-nowrap">
                                <a asp-area="Admin" asp-controller="Article" asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-warning">Upravit</a>
                                <a asp-area="Admin" asp-controller="Article" asp-action="Delete" asp-route-id="@article.Id" class="btn btn-sm btn-danger">Smazat</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">Zatím nebyly vytvořeny žádné články.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
