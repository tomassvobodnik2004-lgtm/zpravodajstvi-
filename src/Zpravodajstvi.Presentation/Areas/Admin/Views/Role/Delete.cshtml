@model RoleDto
@{
    ViewData["Title"] = "Smazat roli";
}

<div class="container mt-4">
    <h2>Opravdu chcete smazat tuto roli?</h2>

    @* Chyba z DeleteConfirmed, např. systémová role nebo role přiřazená uživatelům *@
    <div asp-validation-summary="ModelOnly" class="alert alert-warning mt-3" role="alert"></div>

    <div class="alert alert-danger mt-3 shadow-sm">
        <h4 class="alert-heading">🔑 @Model.Name</h4>
        <p class="mb-1"><strong>Počet uživatelů s touto rolí:</strong> @Model.UsersCount</p>
        <hr />
        <p class="mb-0 text-muted">Smazat lze jen vlastní roli, kterou nemá žádný uživatel. Tuto akci nelze vzít zpět.</p>
    </div>

    <form asp-area="Admin" asp-controller="Role" asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger me-2">Ano, trvale smazat</button>
        <a asp-area="Admin" asp-controller="Role" asp-action="Index" class="btn btn-secondary">Zrušit</a>
    </form>
</div>
