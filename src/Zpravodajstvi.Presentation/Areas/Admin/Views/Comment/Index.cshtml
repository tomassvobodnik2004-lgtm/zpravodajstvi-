@model IEnumerable<CommentDto>
@{
    ViewData["Title"] = "Správa komentářů";
}

<div class="container mt-4">
    <partial name="_AdminNav" />
    <partial name="_StatusMessages" />

    <h2 class="mb-3">Správa komentářů</h2>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Článek</th>
                    <th>Autor</th>
                    <th>Komentář</th>
                    <th>Datum</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var comment in Model)
                    {
                        <tr>
                            <td>
                                <a asp-area="" asp-controller="Home" asp-action="Details" asp-route-id="@comment.ArticleId">@comment.ArticleTitle</a>
                            </td>
                            <td>@comment.AuthorName</td>
                            <td>@(comment.Content.Length > 100 ? comment.Content[..100] + "…" : comment.Content)</td>
                            <td class="text-nowrap">@comment.CreatedAt.ToString("d. M. yyyy HH:mm")</td>
                            <td class="text-nowrap">
                                <a asp-area="Admin" asp-controller="Comment" asp-action="Edit" asp-route-id="@comment.Id" class="btn btn-sm btn-warning">Upravit</a>
                                <a asp-area="Admin" asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" class="btn btn-sm btn-danger">Smazat</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">Zatím nebyly napsány žádné komentáře.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
