@using Microsoft.AspNetCore.Identity
@using Zpravodajstvi.Infrastructure.Identity
@using Zpravodajstvi.Infrastructure.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var primaryRole = roles.FirstOrDefault() ?? "Uživatel";

    @if (User.IsInRole(DbInitializer.RoleAdmin) || User.IsInRole(DbInitializer.RoleRedaktor))
    {
        <li class="nav-item me-2">
            <a class="btn btn-sm btn-warning text-dark fw-bold" asp-area="Admin" asp-controller="Article" asp-action="Index">
                ⚙️ Administrace
            </a>
        </li>
    }

    <li class="nav-item me-2">
        <span class="badge bg-primary text-uppercase me-1">@primaryRole</span>
        <span class="text-white fw-semibold">@(currentUser?.FullName ?? User.Identity?.Name)</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-sm btn-outline-danger">Odhlásit se</button>
        </form>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="btn btn-sm btn-outline-primary" asp-area="" asp-controller="Account" asp-action="Register">Registrace</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-sm btn-primary" asp-area="" asp-controller="Account" asp-action="Login">Přihlásit se</a>
    </li>
}
</ul>
