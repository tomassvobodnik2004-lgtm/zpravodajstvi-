@model ArticleCreateViewModel
@{
    ViewData["Title"] = "Nový článek";
}

<div class="container mt-4">
    <h2>Vytvořit nový článek</h2>
    <hr />

    <form asp-area="Admin" asp-controller="Article" asp-action="Create" method="post" enctype="multipart/form-data">
        <partial name="_ArticleFormFields" model="Model" />

        <div class="mb-3">
            <label asp-for="ImageFile" class="form-label"></label>
            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Uložit článek</button>
        <a asp-area="Admin" asp-controller="Article" asp-action="Index" class="btn btn-secondary">Zpět na výpis</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
