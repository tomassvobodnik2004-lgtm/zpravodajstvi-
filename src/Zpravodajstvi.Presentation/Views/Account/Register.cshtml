@model Zpravodajstvi.Presentation.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registrace nového čtenáře";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white text-center py-3">
                <h4 class="mb-0 fw-bold">Registrace čtenáře</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="např. Jan Novák" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="např. jan.novak@email.cz" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-light border small mb-3">
                        ℹ️ Po registraci získáte roli <strong>Čtenář</strong> s oprávněním číst články a přidávat komentáře.
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">Zaregistrovat se</button>
                </form>
            </div>
            <div class="card-footer text-center bg-white py-3 border-0">
                Již máte účet? <a asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]">Přihlaste se</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
