@model IEnumerable<CategoryDto>
@{
    ViewData["Title"] = "Správa kategorií";
}

<div class="container mt-4">
    <partial name="_AdminNav" />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">Správa kategorií</h2>
        <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-primary">
            + Přidat novou kategorii
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Název kategorie</th>
                    <th>Počet článků</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var cat in Model)
                    {
                        <tr>
                            <td>@cat.Id</td>
                            <td>@cat.Name</td>
                            <td>@cat.ArticlesCount</td>
                            <td class="text-nowrap">
                                <a asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-warning">Upravit</a>
                                <a asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-danger">Smazat</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">Zatím nebyly vytvořeny žádné kategorie.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
