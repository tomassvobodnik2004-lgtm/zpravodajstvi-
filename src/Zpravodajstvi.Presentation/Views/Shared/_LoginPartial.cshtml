@using System.Security.Claims
@using Zpravodajstvi.Application.Interfaces
@using Zpravodajstvi.Domain.Constants
@* Přihlášení se pozná z User.Identity a role z User.IsInRole, jméno dodá IUserService (vrstva Application) *@
@inject IUserService UserService

<ul class="navbar-nav align-items-center">
@if (User.Identity?.IsAuthenticated == true)
{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var displayName = (userId != null ? await UserService.GetDisplayNameAsync(userId) : null) ?? User.Identity?.Name;
    var primaryRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Uživatel";

    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Redaktor))
    {
        <li class="nav-item me-2">
            <a class="btn btn-sm btn-warning text-dark fw-bold" asp-area="Admin" asp-controller="Article" asp-action="Index">
                ⚙️ Administrace
            </a>
        </li>
    }

    <li class="nav-item me-2">
        <span class="badge bg-primary text-uppercase me-1">@primaryRole</span>
        <a class="text-white fw-semibold text-decoration-none" asp-area="" asp-controller="Account" asp-action="Profile" title="Můj profil">@displayName</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-sm btn-outline-danger">Odhlásit se</button>
        </form>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="btn btn-sm btn-outline-primary" asp-area="" asp-controller="Account" asp-action="Register">Registrace</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-sm btn-primary" asp-area="" asp-controller="Account" asp-action="Login">Přihlásit se</a>
    </li>
}
</ul>
