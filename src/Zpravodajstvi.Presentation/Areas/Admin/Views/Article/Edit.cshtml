@model ArticleEditViewModel
@{
    ViewData["Title"] = "Upravit článek";
}

<div class="container mt-4">
    <h2>Upravit článek</h2>
    <hr />

    <form asp-area="Admin" asp-controller="Article" asp-action="Edit" method="post" enctype="multipart/form-data">
        <!-- Zásadní krok: musíme odeslat ID článku zpět na server, ale uživatel ho nesmí vidět -->
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingImageUrl" />

        <partial name="_ArticleFormFields" model="Model" />

        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
        {
            <div class="mb-3">
                <span class="form-label d-block">Stávající obrázek</span>
                <img src="@Model.ExistingImageUrl" alt="Obrázek článku" class="img-thumbnail" style="max-height: 150px;" />
            </div>
        }

        <div class="mb-3">
            <label asp-for="ImageFile" class="form-label">Změnit obrázek článku (volitelné)</label>
            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
            <small class="form-text text-muted">Nový obrázek nahradí ten stávající.</small>
            <span asp-validation-for="ImageFile" class="text-danger d-block"></span>
        </div>

        <button type="submit" class="btn btn-warning">Uložit změny</button>
        <a asp-area="Admin" asp-controller="Article" asp-action="Index" class="btn btn-secondary">Zpět na výpis</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
