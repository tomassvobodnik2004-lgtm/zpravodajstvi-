@model Zpravodajstvi.Application.DTOs.ArticleDetailDto
@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IModelMetadataProvider MetadataProvider
@inject ValidationHtmlAttributeProvider ValidationAttributeProvider
@{
    ViewData["Title"] = Model.Title;
    // Id přihlášeného uživatele – vlastník komentáře se pozná podle shody s comment.UserId
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    // Moderátoři (Admin a Redaktor) mohou upravit a smazat jakýkoli komentář
    var isModerator = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Redaktor);

    // Atributy data-val-* pro klientskou validaci úpravy komentáře. MVC je vygeneruje z pravidel UpdateComment.Content
    // ([Required], [StringLength], [NoProfanity]), takže prohlížeč kontroluje totéž co server.
    var editContentExplorer = MetadataProvider.GetModelExplorerForType(typeof(UpdateComment), null)
        .GetExplorerForProperty(nameof(UpdateComment.Content));
    var editValidationAttributes = new Dictionary<string, string>();
    ValidationAttributeProvider.AddValidationAttributes(ViewContext, editContentExplorer, editValidationAttributes);
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Tlačítko zpět -->
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-4">← Zpět na přehled zpráv</a>

        <!-- Hlavička a obsah článku -->
        <article class="card p-4 p-md-5 rounded shadow-sm mb-5 border-0">
            <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                <span class="badge bg-primary fs-6">@Model.CategoryName</span>
                <span class="text-muted small">✍️ Autor: <strong>@Model.AuthorName</strong></span>
                <span class="text-muted small">Publikováno: @Model.CreatedAt.ToString("d. M. yyyy v HH:mm")</span>
                @if (Model.UpdatedAt.HasValue)
                {
                    <span class="text-muted small italic">(Aktualizováno: @Model.UpdatedAt.Value.ToString("d. M. yyyy HH:mm"))</span>
                }
            </div>

            <h1 class="display-6 fw-bold mb-3 text-body">@Model.Title</h1>

            <!-- Perex -->
            <p class="lead text-secondary border-start border-4 border-primary ps-3 my-4">
                @Model.Perex
            </p>

            <!-- Hlavní obrázek / Galerie obrázků článku -->
            @if (Model.Images.Any())
            {
                <div class="my-4">
                    @foreach (var img in Model.Images)
                    {
                        <figure class="figure w-100">
                            <img src="@img.Url" class="figure-img img-fluid rounded w-100 shadow-sm" alt="@img.Caption" style="max-height: 480px; object-fit: cover;" />
                            @if (!string.IsNullOrEmpty(img.Caption))
                            {
                                <figcaption class="figure-caption text-center mt-2 text-muted">📷 @img.Caption</figcaption>
                            }
                        </figure>
                    }
                </div>
            }

            <!-- Plný text článku -->
            <div class="article-content fs-5 lh-lg my-4 text-body" style="white-space: pre-line;">
                @Model.Content
            </div>

            <!-- Štítky článku -->
            @if (Model.Tags.Any())
            {
                <div class="pt-4 border-top">
                    <span class="fw-semibold me-2">Štítky:</span>
                    @foreach (var tag in Model.Tags)
                    {
                        <a asp-action="Index" asp-route-tag="@tag" class="badge bg-light text-secondary text-decoration-none border me-1 py-2 px-3">
                            #@tag
                        </a>
                    }
                </div>
            }
        </article>

        <!-- Sekce komentářů -->
        <section id="comments" class="card p-4 p-md-5 rounded shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h3 class="fw-bold mb-0 text-body">💬 Diskuze k článku (@Model.Comments.Count)</h3>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    ✅ @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Formulář pro přidání komentáře -->
            <div class="card bg-body-tertiary border-0 mb-4 p-3 p-md-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <h5 class="fw-bold mb-3 text-body">Přidat komentář</h5>
                    <form asp-controller="Comments" asp-action="Add" method="post">
                        <input type="hidden" asp-for="NewComment.ArticleId" value="@Model.Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @* Jméno se jen zobrazuje (pole nemá atribut name, takže se neodesílá) – autora určuje server podle účtu *@
                        <div class="mb-3">
                            <label for="commentAuthorName" class="form-label fw-semibold text-body">Vaše jméno</label>
                            <input id="commentAuthorName" class="form-control" value="@Model.CurrentUserName" readonly="readonly" />
                            <small class="form-text text-muted">Jméno autora je svázáno s vaším účtem a nelze ho měnit.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewComment.Content" class="form-label fw-semibold text-body"></label>
                            <textarea asp-for="NewComment.Content" class="form-control" rows="4" placeholder="Napište svůj názor k článku (vulgární výrazy budou zablokovány)..."></textarea>
                            <span asp-validation-for="NewComment.Content" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">ℹ️ Komentáře jsou kontrolovány filtrem nevhodných slov.</small>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">Odeslat komentář</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-center py-3">
                        <h5 class="fw-bold mb-2 text-body">Zapojte se do diskuze</h5>
                        <p class="text-muted mb-3">Pro přidávání komentářů je vyžadováno přihlášení s rolí Čtenář.</p>
                        <a asp-controller="Account" asp-action="Login" asp-route-returnurl="@Context.Request.Path" class="btn btn-primary me-2">Přihlásit se</a>
                        <a asp-controller="Account" asp-action="Register" asp-route-returnurl="@Context.Request.Path" class="btn btn-outline-primary">Registrovat se</a>
                    </div>
                }
            </div>

            <!-- Výpis existujících komentářů -->
            @if (!Model.Comments.Any())
            {
                <div class="text-center py-4 text-muted">
                    Zatím zde nejsou žádné komentáře. Buďte první, kdo se vyjádří!
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var comment in Model.Comments)
                    {
                        // Spravovat komentář smí moderátor nebo jeho autor – shoda Id uživatele, ne jména
                        var canManage = isModerator || (comment.UserId != null && comment.UserId == currentUserId);
                        // Úprava tohoto komentáře neprošla validací – formulář zůstane otevřený s chybou
                        var failedEdit = Model.EditComment?.Id == comment.Id ? Model.EditComment : null;

                        <div class="card border rounded p-3" id="comment-@comment.Id">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <span class="fw-bold text-body">👤 @comment.AuthorName</span>
                                    <small class="text-muted ms-2">@comment.CreatedAt.ToString("d. M. yyyy v HH:mm")</small>
                                </div>

                                @* Tlačítka se zobrazí pouze moderátorovi (Admin, Redaktor) nebo autorovi komentáře *@
                                @if (canManage)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <!-- Tlačítko pro rozbalení formuláře na úpravu -->
                                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#editComment-@comment.Id">
                                            ✏️ Upravit
                                        </button>

                                        <!-- Formulář pro smazání -->
                                        <form asp-controller="Comments" asp-action="Delete" method="post" onsubmit="return confirm('Opravdu chcete smazat tento komentář?');" class="d-inline">
                                            <input type="hidden" name="id" value="@comment.Id" />
                                            <input type="hidden" name="articleId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-outline-danger">🗑️ Smazat</button>
                                        </form>
                                    </div>
                                }
                            </div>

                            <p class="mb-0 text-secondary" style="white-space: pre-line;">@comment.Content</p>

                            @* Editační formulář (rozbalí se pod komentářem, po chybě validace zůstane otevřený) *@
                            @if (canManage)
                            {
                                <div class="collapse comment-edit-collapse mt-3 pt-3 border-top @(failedEdit != null ? "show" : "")" id="editComment-@comment.Id">
                                    <form asp-controller="Comments" asp-action="Edit" method="post">
                                        <input type="hidden" name="EditComment.Id" value="@comment.Id" />
                                        <input type="hidden" name="EditComment.ArticleId" value="@Model.Id" />
                                        <div class="mb-2">
                                            <label for="editCommentContent-@comment.Id" class="form-label fw-semibold small">Úprava komentáře:</label>
                                            @{
                                                // Pole se jmenuje EditComment.Content (controller ho váže přes [Bind(Prefix = "EditComment")])
                                                // a nese validační atributy z editValidationAttributes. Tag helper asp-for se tu nepoužívá,
                                                // protože by po neúspěšné úpravě vložil odeslaný text do formulářů všech komentářů.
                                                var editTextarea = new TagBuilder("textarea");
                                                foreach (var attribute in editValidationAttributes)
                                                {
                                                    editTextarea.Attributes[attribute.Key] = attribute.Value;
                                                }
                                                editTextarea.Attributes["id"] = $"editCommentContent-{comment.Id}";
                                                editTextarea.Attributes["name"] = "EditComment.Content";
                                                editTextarea.Attributes["rows"] = "3";
                                                editTextarea.AddCssClass("form-control");
                                                editTextarea.InnerHtml.Append(failedEdit?.Content ?? comment.Content);
                                            }
                                            @editTextarea
                                            @if (failedEdit != null)
                                            {
                                                <span asp-validation-for="EditComment.Content" class="text-danger small"></span>
                                            }
                                            else
                                            {
                                                <span class="text-danger small field-validation-valid" data-valmsg-for="EditComment.Content" data-valmsg-replace="true"></span>
                                            }
                                        </div>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-light" data-bs-toggle="collapse" data-bs-target="#editComment-@comment.Id">Zrušit</button>
                                            <button type="submit" class="btn btn-sm btn-primary">Uložit změny</button>
                                        </div>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Formulář úpravy komentáře je schovaný v rozbalovacím panelu. Po rozbalení ho jQuery Validation
        // načte znovu (unobtrusive.parse), aby text kontroloval podle stejných pravidel jako server.
        document.querySelectorAll('.comment-edit-collapse').forEach(function (panel) {
            panel.addEventListener('shown.bs.collapse', function () {
                var form = panel.querySelector('form');
                $(form).removeData('validator').removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse(form);
            });
        });
    </script>
}
