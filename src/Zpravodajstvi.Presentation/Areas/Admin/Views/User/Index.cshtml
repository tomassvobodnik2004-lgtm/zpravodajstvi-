@model IEnumerable<UserViewModel>
@{
    ViewData["Title"] = "Správa uživatelů";
}

<div class="container mt-4">
    <partial name="_AdminNav" />
    <partial name="_StatusMessages" />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">Správa uživatelských účtů</h2>
        <a asp-area="Admin" asp-controller="User" asp-action="Create" class="btn btn-primary">
            + Přidat nový účet
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Jméno</th>
                    <th>E-mail</th>
                    <th>Role</th>
                    <th>Datum registrace</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr>
                            <td><strong>@user.FullName</strong></td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.CurrentRole == AppRoles.Admin)
                                {
                                    <span class="badge bg-danger fs-6">Admin</span>
                                }
                                else if (user.CurrentRole == AppRoles.Redaktor)
                                {
                                    <span class="badge bg-warning text-dark fs-6">Redaktor</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark fs-6">@user.CurrentRole</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-nowrap">
                                <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning me-1">
                                    ✏️ Upravit účet
                                </a>
                                <form asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Opravdu chcete smazat tento účet?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Smazat</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">Nebyli nalezeni žádní uživatelé.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
