@model TagDto
@{
    ViewData["Title"] = "Smazat štítek";
}

<div class="container mt-4">
    <h2>Opravdu chcete smazat tento štítek?</h2>

    <div class="alert alert-danger mt-3 shadow-sm">
        <h4 class="alert-heading">🏷️ #@Model.Name</h4>
        <p class="mb-1"><strong>ID štítku:</strong> @Model.Id | <strong>Počet článků se štítkem:</strong> @Model.ArticlesCount</p>
        <hr />
        <p class="mb-0 text-muted">Články zůstanou zachovány, jen z nich zmizí tento štítek. Tuto akci nelze vzít zpět.</p>
    </div>

    <form asp-area="Admin" asp-controller="Tag" asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger me-2">Ano, trvale smazat</button>
        <a asp-area="Admin" asp-controller="Tag" asp-action="Index" class="btn btn-secondary">Zrušit</a>
    </form>
</div>
