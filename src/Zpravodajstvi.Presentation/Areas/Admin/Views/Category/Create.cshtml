@model CategoryViewModel
@{
    ViewData["Title"] = "Nová kategorie";
}

<div class="container mt-4">
    <h2>Vytvořit novou kategorii</h2>
    <hr />

    <form asp-area="Admin" asp-controller="Category" asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Uložit kategorii</button>
        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-secondary">Zpět na seznam</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
