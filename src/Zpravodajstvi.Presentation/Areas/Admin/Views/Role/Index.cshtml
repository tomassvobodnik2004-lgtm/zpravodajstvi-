@model IEnumerable<RoleDto>
@{
    ViewData["Title"] = "Správa rolí";
}

<div class="container mt-4">
    <partial name="_AdminNav" />
    <partial name="_StatusMessages" />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">Správa rolí</h2>
        <a asp-area="Admin" asp-controller="Role" asp-action="Create" class="btn btn-primary">
            + Přidat novou roli
        </a>
    </div>

    <p class="text-muted small">
        Systémové role používá aplikace pro oprávnění: <strong>Admin</strong> spravuje vše,
        <strong>Redaktor</strong> (manager) spravuje obsah, <strong>Ctenar</strong> (uživatel) čte a komentuje.
        Roli konkrétnímu uživateli přiřadíte ve správě uživatelů.
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Název role</th>
                    <th>Počet uživatelů</th>
                    <th>Typ</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td><strong>@role.Name</strong></td>
                        <td>@role.UsersCount</td>
                        <td>
                            @if (role.IsSystemRole)
                            {
                                <span class="badge bg-secondary">Systémová</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Vlastní</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (!role.IsSystemRole)
                            {
                                <a asp-area="Admin" asp-controller="Role" asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-warning">Přejmenovat</a>
                                <a asp-area="Admin" asp-controller="Role" asp-action="Delete" asp-route-id="@role.Id" class="btn btn-sm btn-danger">Smazat</a>
                            }
                            else
                            {
                                <span class="text-muted small">Nelze měnit</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
